# Environment Configuration Example
# Copy this file to .env and fill in your values

# =============================================================================
# Identity Provider Configuration
# Get these from your IdP (Auth0, Clerk, Supabase, etc.)
# =============================================================================
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_AUDIENCE=your-api-identifier
JWT_ISSUER=https://your-auth0-domain.auth0.com/
JWT_ALGORITHM=RS256

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
SANDBOX_API_URL=http://127.0.0.1:8000
SNAPSHOT_API_URL=http://127.0.0.1:8002
AGENT_API_URL=http://127.0.0.1:8003
PREVIEW_ROUTER_URL=http://127.0.0.1:8001

# =============================================================================
# Workspace Configuration
# =============================================================================
WORKSPACE_BASE_DIR=/srv/workspaces
SNAPSHOT_BASE_DIR=/srv/snapshots
SANDBOX_ROOT=/tmp/sandboxes

# =============================================================================
# Snapshot Configuration
# =============================================================================
SNAPSHOT_RETENTION_COUNT=5
SNAPSHOT_ON_IDLE=true
SNAPSHOT_ON_SAVE=true
SNAPSHOT_DAILY=false

# =============================================================================
# Container Configuration
# =============================================================================
CONTAINER_IMAGE=ubuntu:22.04
CONTAINER_PREFIX=shell-
CONTAINER_RUNTIME=auto

# =============================================================================
# Storage Configuration
# For S3-compatible storage (leave empty for local storage)
# =============================================================================
STORAGE_BACKEND=auto
# STORAGE_BACKEND=s3

# S3/MinIO Configuration
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ephemeral-snapshots
S3_REGION=us-east-1
S3_PREFIX=snapshots/

# Local Storage Directory (if using local backend)
LOCAL_STORAGE_DIR=/tmp/ephemeral-storage

# =============================================================================
# Resource Quotas
# =============================================================================
QUOTA_EXECUTIONS_PER_HOUR=120
QUOTA_MAX_CONCURRENT=10
QUOTA_MAX_MEMORY_MB=2048
QUOTA_MAX_STORAGE_BYTES=5368709120
QUOTA_MAX_CPU_SECONDS_PER_HOUR=3600
QUOTA_MAX_NETWORK_EGRESS_BYTES_PER_HOUR=1073741824

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# Tool Integrations (Optional)
# =============================================================================
# Composio API key for tool integrations (GitHub, Slack, Notion, etc.)
# Get your API key from https://app.composio.dev/
COMPOSIO_API_KEY=

# =============================================================================
# Observability (Optional)
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_FORMAT=json

# OpenTelemetry OTLP endpoint for distributed tracing
# Example: http://localhost:4317
OTLP_ENDPOINT=

# Enable Prometheus metrics endpoint
ENABLE_METRICS=true

# =============================================================================
# Allowed Commands (comma-separated)
# =============================================================================
ALLOWED_COMMANDS=python,node

# =============================================================================
# Default Timeouts
# =============================================================================
DEFAULT_TIMEOUT=15

# =============================================================================
# Security Notes
# =============================================================================
# - Never commit .env files with real credentials to version control
# - Rotate JWT keys periodically
# - Use strong, unique S3 credentials
# - Enable MFA on all identity provider accounts
# - Review rate limits based on your expected traffic patterns
